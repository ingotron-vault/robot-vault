# DEVELOPMENT ONLY. Copy to `.env` (git-ignored) and edit for
# `docker-compose.yml`. Never use this file or these defaults for a release;
# the supported release workflow requires a separate 0600 `RELEASE_ENV_FILE`
# and validates it before creating containers. Every development
# `docker compose` invocation reads `.env` automatically, so it is the one
# place to override the defaults baked into docker-compose.yml. Nothing here is
# required for the local stack. See CONFIG_REFERENCE.md and README "Network
# exposure and authentication".

# --- Ingest authentication -------------------------------------------------
# Shared bearer token required on every UploadService RPC and /admin/* request.
# `make secrets` (run by `make stack-up`) generates a random one into .env if
# you have none. The compose fallback is the committed, known-weak
# `dev-ingest-token-change-me`. Never use it outside localhost. The dev
# ingest entrypoint refuses that fallback when DEBUG_BIND_HOST or
# ROBOT_BIND_HOST is widened.
#INGEST_AUTH_TOKEN=change-me

# Separate bearer token for the robot-provisioning API. It is optional in the
# local development profile and required in the release stack. Use at
# least 32 visible ASCII characters and never reuse INGEST_AUTH_TOKEN.
#INGEST_PROVISIONING_TOKEN=change-me

# --- TLS/mTLS for the ingest gRPC listener ---------------------------------
# Run `make certs` first; see docs/CONFIG_REFERENCE.md (ingest TLS/mTLS).
# TLS_MTLS applies to the development stack only; the release stack derives it
# from INGEST_SECURITY_PROFILE (`token` or `mtls`).
#TLS_ENABLED=true
#TLS_MTLS=true
#TLS_SERVER_CERT=/app/certs/ingest.crt
#TLS_SERVER_KEY=/app/certs/ingest.key
#TLS_CA_CERT=/app/certs/ca.crt

# --- Host ports --------------------------------------------------------------
# Only the user-facing services publish anything by default. The data plane
# (ingest/postgres/objectstore) is published only via docker-compose.debug.yml
# (`make debug-up`), on 127.0.0.1 unless DEBUG_BIND_HOST says otherwise.
#QUERY_PORT=8003
#UI_PORT=5173
#ROBOT_PORT=8090
#DEBUG_BIND_HOST=127.0.0.1
#INGEST_GRPC_PORT=50051
#INGEST_ADMIN_PORT=8080
#POSTGRES_PORT=5432
#OBJECTSTORE_API_PORT=9002

# --- Storage / database ------------------------------------------------------
#OBJECTSTORE_ROOT_USER=robot-vault-dev-root
# The root password is a file (a Compose secret); the default is the committed
# development file configs/objectstore-root-password.dev.
#OBJECTSTORE_ROOT_PASSWORD_FILE=./configs/objectstore-root-password.dev
# One object-store key per service (fixed access keys robot-vault-<service>).
#INGEST_S3_SECRET_KEY=dev-ingest-s3-secret-change-me
#PROCESSOR_S3_SECRET_KEY=dev-processor-s3-secret-change-me
#EXPORTER_S3_SECRET_KEY=dev-exporter-s3-secret-change-me
#QUERY_S3_SECRET_KEY=dev-query-s3-secret-change-me
#GC_S3_SECRET_KEY=dev-gc-s3-secret-change-me
#S3_BUCKET=robotics-data
#DATABASE_URL=postgres://robotvault:robotvault@postgres:5432/robotvault

# --- Robot data ---------------------------------------------------------------
# Host directory holding <robot_id>/YYYY-MM-DD/*.mcap, bind-mounted into the
# robot/dev containers at /tmp/robot_data.
#ROBOT_DATA_HOST_DIR=/absolute/path/to/rosbags

# --- Garbage collector -------------------------------------------------------
#GC_DRY_RUN=true
