# DEVELOPMENT ONLY ingest defaults. Release Compose overrides the owner DSN and
# object-store key with the scoped ingest role. docker-compose.yml sets the
# ingest object-store key (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
STORAGE_ROOT=/app/uploads
S3_BUCKET=robotics-data
S3_ENDPOINT=http://objectstore:9000
S3_REGION=us-east-1
# There is no S3_USE_PATH_STYLE: path-style addressing is hardcoded on
# (main.rs: force_path_style(true)).
S3_SECURE=false
ENABLE_FILE_CAS=true
DATABASE_URL=postgres://robotvault:robotvault@postgres:5432/robotvault
# Startup rejects zero, malformed, or excessive values (per robot: 1..=16;
# global: 1..=64) rather than creating a deadlocked/overcommitted service.
PER_ROBOT_CONCURRENCY=2
GLOBAL_CONCURRENCY=8
# Bound unauthenticated pre-metadata waits and silent gaps on active streams.
INGEST_FIRST_MESSAGE_TIMEOUT_SECONDS=10
INGEST_STREAM_IDLE_TIMEOUT_SECONDS=600
