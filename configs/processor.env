# DEVELOPMENT ONLY processor defaults. Release Compose injects the scoped
# processor database role and object-store key explicitly. docker-compose.yml
# sets the development processor key (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
PYTHONPATH=/app/src
PROMETHEUS_MULTIPROC_DIR=/tmp
DATABASE_URL=postgres://robotvault:robotvault@postgres:5432/robotvault
S3_BUCKET=robotics-data
S3_ENDPOINT=http://objectstore:9000
S3_REGION=us-east-1
# There is no S3_USE_PATH_STYLE: the processor builds a
# PyArrow S3FileSystem from S3_ENDPOINT/S3_REGION/S3_SECURE only.
S3_SECURE=false
