# Query service defaults for deploy/docker-compose.release.yml.
#
# This file deliberately contains no credentials and no deployment-specific
# identity-provider, database or object-store values. Public OIDC inputs and
# the query service's own scoped database/S3 credentials come from
# RELEASE_ENV_FILE through explicit release Compose entries; no shared
# credential anchor exists.
# The verifier and browser-client OIDC values, QUERY_PUBLIC_HOST, and TLS
# certificate/key/CA paths are required Compose inputs. The release topology
# hard-overrides release mode, auth mode, dev auth, RS256-only verification,
# claim-based roles, and HSTS so development
# auth/plain HTTP cannot be enabled by editing this file; the scopes below are
# only a safe public-client default.
REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
QUERY_MAX_REQUEST_BODY_BYTES=8388608
DUCKDB_MEMORY_LIMIT_MB=512
DUCKDB_QUERY_CONCURRENCY=4
DUCKDB_QUERY_ACQUIRE_TIMEOUT_SECONDS=5
SQL_CONSOLE_MEMORY_LIMIT_MB=512
AUTH_MODE=oidc
OIDC_DEV=false
ROBOT_VAULT_RELEASE=true
OIDC_ALGORITHMS=RS256
OIDC_ROLE_SOURCE=claim
OIDC_ROLE_CLAIM=roles
OIDC_SCOPES=openid profile email offline_access
ENABLE_HSTS=true
# The shipped UI is served same-origin, so release needs no cross-origin
# allowance. Pin this empty so a release deployment can never fall back to the
# development Vite origins (localhost:5173) baked in as the code default; an
# operator that genuinely needs a separate browser origin sets it explicitly.
CORS_ALLOWED_ORIGINS=
