# DEVELOPMENT ONLY query defaults (including local dev OIDC). Release uses
# configs/query.release.env plus explicit scoped
# query credentials from RELEASE_ENV_FILE.
S3_PARQUET_BUCKET=robotics-data
S3_ENDPOINT=http://objectstore:9000
S3_REGION=us-east-1
# docker-compose.yml sets the query object-store key (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
S3_SECURE=false
REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
QUERY_MAX_REQUEST_BODY_BYTES=8388608
DUCKDB_MEMORY_LIMIT_MB=512
DUCKDB_QUERY_CONCURRENCY=4
DUCKDB_QUERY_ACQUIRE_TIMEOUT_SECONDS=5
SQL_CONSOLE_MEMORY_LIMIT_MB=512
DATABASE_URL=postgres://robotvault:robotvault@postgres:5432/robotvault
# Where a BROWSER can reach the object store directly. Unset by default: the dev
# stack does not publish its host port, so http://localhost:9002 would hand the browser
# a dead address. Left empty, /api/v1/s3/presign returns this service's own
# /api/v1/s3/download proxy instead, which is reachable because query stays
# published. Set this only if you genuinely expose the object store to clients.
# S3_PUBLIC_ENDPOINT=http://localhost:9002
AUTH_MODE=oidc
OIDC_DEV=true
OIDC_ROLE_CLAIM=roles
