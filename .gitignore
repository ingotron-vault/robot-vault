# Python
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
**/*.egg-info/
.venv/

# Generated gRPC/protobuf stubs (regenerated by root Dockerfile and
# .github/workflows/core-ci.yml from proto/upload.proto and proto/enrollment.proto
# -- never hand-edit, never commit; run `make proto` to regenerate locally)
**/upload_pb2*.py
**/enrollment_pb2*.py

# Local data and caches
/uploads/
/tmp/
/tmp_*.db
/tmp_fixture_*
# Large, redistributable-but-not-repository-sized inputs used by `make examples`.
# The generated few-MiB bundle under /examples is committed; the 1.4 GB TUM
# source bag and pinned ALOHA source shard are not. They download under
# /.cache/, so the whole directory is ignored.
/.cache/
# Local build output.
/build/
# Durable per-file upload manifests/configs for `make seed-examples`.
/.example-seed/
# development/sim_gen output (regenerate with the CLI in its README, never commit)
/tmp_simgen/
/certs/
# Local secret files, such as signing keys. Never commit them: a committed
# private key lets anyone forge a signature with it.
/secrets/
# Local notes at the repository root (for example release credential notes).
# They can hold secret values; never commit them.
/*.local.md
/db/*.db

# Postgres and object-store persistent data dir (bind-mounted; see docker-compose.yml, OPERATIONS.md)
/data/*
!/data/.gitkeep

# Rust build artifacts
**/target/

# SQLite and other DBs (keep only explicit ones under configs)
*.db
!configs/*.db

# Node/yarn caches (if any UI later)
node_modules/

# UI workspace build artifacts (dist output, not source) -- `make ui-build`
# regenerates both.
phases/05-query-service/src/ui-spa/dist/
phases/02-robot-upload-agent/src/robot_upload_agent/ui/
*.log
# IDE and editor files
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
# local verification env (dev creds)
.env
# local verification port remaps
docker-compose.override.yml
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local tool state
.lavish/

# Tool-local scratch
/.tmp/
/.codex/
/.codex-tmp/
*.gate.lock*
