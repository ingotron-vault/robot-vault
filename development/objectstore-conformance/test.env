# Throwaway credentials for the object-store conformance gate only (never used outside these tests).
# ROOT_* seeds fixtures and does backup and restore; the five <SVC>_S3_* keys are required (suite_env.py).
S3_ENDPOINT=http://objectstore:9000
S3_PUBLIC_ENDPOINT=http://objectstore-public:9000
S3_BUCKET=rv-test
S3_REGION=us-east-1
ROOT_ACCESS_KEY=rdv-test-root
ROOT_SECRET_KEY=rdv-test-root-secret-0001
INGEST_S3_ACCESS_KEY=robot-vault-ingest
INGEST_S3_SECRET_KEY=rdv-test-ingest-secret-01
PROCESSOR_S3_ACCESS_KEY=robot-vault-processor
PROCESSOR_S3_SECRET_KEY=rdv-test-processor-secr01
EXPORTER_S3_ACCESS_KEY=robot-vault-exporter
EXPORTER_S3_SECRET_KEY=rdv-test-exporter-secre01
QUERY_S3_ACCESS_KEY=robot-vault-query
QUERY_S3_SECRET_KEY=rdv-test-query-secret-001
GC_S3_ACCESS_KEY=robot-vault-gc
GC_S3_SECRET_KEY=rdv-test-gc-secret-000001
# The bootstrap one-shot (development/objectstore/bootstrap.py) reads the root key under these names.
OBJECTSTORE_ROOT_USER=rdv-test-root
OBJECTSTORE_ROOT_PASSWORD=rdv-test-root-secret-0001
HEALTH_URL=http://objectstore:9000/health/ready
STORE=rustfs-1.0.6-pinned
RESTORE_BUCKET=rv-test-restore
RCLONE_PROVIDER=Other
