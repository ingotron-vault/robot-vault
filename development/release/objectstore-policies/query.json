{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketMetadata",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::__ROBOT_VAULT_BUCKET__"
    },
    {
      "Sid": "ListParquetLake",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__ROBOT_VAULT_BUCKET__",
      "Condition": {
        "StringLike": {
          "s3:prefix": "processed/parquet/*"
        }
      }
    },
    {
      "Sid": "ReadQueryData",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::__ROBOT_VAULT_BUCKET__/raw/*",
        "arn:aws:s3:::__ROBOT_VAULT_BUCKET__/cas/files/*",
        "arn:aws:s3:::__ROBOT_VAULT_BUCKET__/processed/parquet/*",
        "arn:aws:s3:::__ROBOT_VAULT_BUCKET__/processed/media/*",
        "arn:aws:s3:::__ROBOT_VAULT_BUCKET__/exports/*"
      ]
    }
  ]
}
